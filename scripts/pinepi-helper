#!/usr/bin/env python3
"""Restricted privileged operations for PinePi.

This program intentionally exposes a small, enumerated command surface. It never
executes a shell and validates every web-controlled value again at the privilege
boundary.
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path

RUN_DIR = Path("/run/pinepi")
CONFIG_PATH = Path(os.environ.get("PINEPI_CONFIG", "/etc/pinepi/pinepi.toml"))
IFACE_RE = re.compile(r"^[a-zA-Z0-9_.-]{1,15}$")
CAPTURE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}\.pcapng$")
MAC_RE = re.compile(r"(?i)^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")


class HelperError(RuntimeError):
    pass


def config() -> dict:
    raw: dict = {}
    if CONFIG_PATH.is_file():
        with CONFIG_PATH.open("rb") as handle:
            raw = tomllib.load(handle)
    storage = raw.get("storage", {})
    ap = raw.get("training_ap", {})
    management = raw.get("management_ap", {})
    adapters = raw.get("adapters", {})
    return {
        "scans": Path(storage.get("scan_path", "/var/lib/pinepi/scans")),
        "captures": Path(storage.get("capture_path", "/var/lib/pinepi/captures")),
        "address": str(ap.get("address", "10.42.0.1/24")),
        "gateway": str(ap.get("gateway", "10.42.0.1")),
        "dhcp_start": str(ap.get("dhcp_start", "10.42.0.20")),
        "dhcp_end": str(ap.get("dhcp_end", "10.42.0.200")),
        "country": str(ap.get("country", "AT")).upper(),
        "management_enabled": bool(management.get("enabled", True)),
        "management_ssid": str(management.get("ssid", "PinePi")),
        "management_password": str(management.get("password", "CHANGE-ME-BEFORE-USE")),
        "management_address": str(management.get("address", "10.43.0.1/24")),
        "management_gateway": str(management.get("gateway", str(management.get("address", "10.43.0.1/24")).split("/", 1)[0])),
        "management_dhcp_start": str(management.get("dhcp_start", "10.43.0.20")),
        "management_dhcp_end": str(management.get("dhcp_end", "10.43.0.100")),
        "management_channel": int(management.get("channel", 1)),
        "management_country": str(management.get("country_code", "AT")).upper(),
        "management_interfaces": tuple(str(value) for value in adapters.get("management_interfaces", ["wlan0"])),
        "management_drivers": tuple(str(value).lower() for value in adapters.get("management_drivers", ["brcmfmac"])),
        "max_active_seconds": min(60, max(1, int(raw.get("active_tests", {}).get("max_runtime_seconds", 30)))),
        "max_deauth_bursts": min(128, max(1, int(raw.get("active_tests", {}).get("max_deauth_bursts", 32)))),
    }


CFG = config()


def reply(**data: object) -> None:
    print(json.dumps({"ok": True, **data}, separators=(",", ":")))


def run(argv: list[str], *, timeout: float = 10, check: bool = True, input_text: str | None = None) -> subprocess.CompletedProcess:
    try:
        result = subprocess.run(argv, input=input_text, text=True, capture_output=True, timeout=timeout, check=False)
    except FileNotFoundError as exc:
        raise HelperError(f"Required executable not found: {argv[0]}") from exc
    except subprocess.TimeoutExpired as exc:
        raise HelperError(f"Command timed out: {argv[0]}") from exc
    if check and result.returncode:
        raise HelperError((result.stderr or result.stdout).strip() or f"{argv[0]} failed")
    return result


def executable(name: str) -> str:
    path = shutil.which(name)
    if not path:
        raise HelperError(f"Required executable not found: {name}")
    return path


def validate_interface(name: str) -> str:
    if not IFACE_RE.fullmatch(name) or not (Path("/sys/class/net") / name / "wireless").exists():
        raise HelperError(f"Invalid or missing wireless interface: {name}")
    return name


def validate_storage(path: Path) -> Path:
    if not path.is_absolute() or path == Path("/"):
        raise HelperError("Storage path must be an absolute, non-root path")
    path.mkdir(parents=True, exist_ok=True, mode=0o750)
    if path.is_symlink():
        raise HelperError("Storage path may not be a symlink")
    return path.resolve()


def state_path(name: str) -> Path:
    if name in {"management", "training"}:
        return RUN_DIR / name / "state.json"
    return RUN_DIR / f"{name}.json"


def load_state(name: str) -> dict:
    try:
        value = json.loads(state_path(name).read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(name: str, value: dict) -> None:
    target = state_path(name)
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    temporary = target.parent / f".state.{os.getpid()}.tmp"
    temporary.write_text(json.dumps(value, separators=(",", ":")))
    os.chmod(temporary, 0o644)
    os.replace(temporary, target)


def process_alive(pid: object, expected: str) -> bool:
    try:
        number = int(pid)
        cmdline = (Path("/proc") / str(number) / "cmdline").read_bytes().decode(errors="replace")
        return number > 1 and expected in cmdline
    except (ValueError, TypeError, OSError):
        return False


def terminate(pid: object, expected: str) -> None:
    if not process_alive(pid, expected):
        return
    number = int(pid)
    with suppress_oserror():
        os.killpg(number, signal.SIGTERM)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and process_alive(number, expected):
        time.sleep(0.1)
    if process_alive(number, expected):
        with suppress_oserror():
            os.killpg(number, signal.SIGKILL)


class suppress_oserror:
    def __enter__(self):
        return self

    def __exit__(self, kind, value, traceback):
        return kind is not None and issubclass(kind, OSError)


def ensure_idle(name: str, expected: str) -> None:
    state = load_state(name)
    if state.get("running") and process_alive(state.get("pid"), expected):
        raise HelperError(f"{name} is already running")
    if state:
        state["running"] = False
        save_state(name, state)


def set_monitor(interface: str, channel: int | None = None) -> None:
    run([executable("ip"), "link", "set", "dev", interface, "down"])
    run([executable("iw"), "dev", interface, "set", "type", "monitor"])
    run([executable("ip"), "link", "set", "dev", interface, "up"])
    if channel is not None:
        run([executable("iw"), "dev", interface, "set", "channel", str(channel)])


def set_managed(interface: str) -> None:
    if not interface:
        return
    run([executable("ip"), "link", "set", "dev", interface, "down"], check=False)
    run([executable("iw"), "dev", interface, "set", "type", "managed"], check=False)
    run([executable("ip"), "link", "set", "dev", interface, "up"], check=False)
    nmcli = shutil.which("nmcli")
    if nmcli:
        run([nmcli, "device", "set", interface, "managed", "yes"], check=False)


def scan_start(interface: str) -> None:
    interface = validate_interface(interface)
    ensure_idle("scan", "airodump-ng")
    capture = load_state("capture")
    if capture.get("running") and process_alive(capture.get("pid"), "dumpcap"):
        raise HelperError("Cannot scan while a capture is running")
    active = load_state("active")
    if active.get("running") and process_alive(active.get("pid"), active.get("executable", "aireplay-ng")):
        raise HelperError("Cannot scan while an active wireless test is running")
    monitor = load_state("monitor")
    if monitor.get("running"):
        raise HelperError("Disable manual monitor mode before starting Recon")
    root = validate_storage(CFG["scans"])
    for path in root.glob("current*"):
        if path.is_file() and not path.is_symlink():
            path.unlink()
    try:
        set_monitor(interface)
        process = start_daemon(
            "airodump-ng",
            [executable("airodump-ng"), "--write", str(root / "current"), "--output-format", "csv", interface],
            RUN_DIR / "recon.log",
            0.35,
        )
    except Exception:
        set_managed(interface)
        raise
    state = {"running": True, "pid": process.pid, "interface": interface, "started_at": time.time()}
    save_state("scan", state)
    reply(**state)


def scan_stop() -> None:
    state = load_state("scan")
    terminate(state.get("pid"), "airodump-ng")
    interface = str(state.get("interface", ""))
    if IFACE_RE.fullmatch(interface):
        set_managed(interface)
    state.update(running=False, stopped_at=time.time())
    save_state("scan", state)
    reply(**state)


def scan_status() -> None:
    state = load_state("scan")
    running = process_alive(state.get("pid"), "airodump-ng")
    state["running"] = running
    if state and not running and "stopped_at" not in state:
        state["stopped_at"] = time.time()
        interface = str(state.get("interface", ""))
        if IFACE_RE.fullmatch(interface):
            set_managed(interface)
        save_state("scan", state)
    reply(**state)


def capture_start(interface: str, channel_text: str, max_mb_text: str) -> None:
    interface = validate_interface(interface)
    try:
        channel, max_mb = int(channel_text), int(max_mb_text)
    except ValueError as exc:
        raise HelperError("Channel and size must be integers") from exc
    if not 1 <= channel <= 196 or not 1 <= max_mb <= 102400:
        raise HelperError("Channel or maximum capture size is out of range")
    ensure_idle("capture", "dumpcap")
    scan = load_state("scan")
    if scan.get("running") and process_alive(scan.get("pid"), "airodump-ng"):
        raise HelperError("Stop the scan before starting a capture")
    active = load_state("active")
    if active.get("running") and process_alive(active.get("pid"), active.get("executable", "aireplay-ng")):
        raise HelperError("Stop the active wireless test before starting a capture")
    monitor = load_state("monitor")
    if monitor.get("running"):
        raise HelperError("Disable manual monitor mode before starting a capture")
    root = validate_storage(CFG["captures"])
    stamp = time.strftime("%Y%m%d-%H%M%S")
    filename = f"capture-{stamp}-{os.getpid()}.pcapng"
    path = root / filename
    try:
        set_monitor(interface, channel)
        process = start_daemon(
            "dumpcap",
            [executable("dumpcap"), "-q", "-i", interface, "-w", str(path), "-a", f"filesize:{max_mb * 1024}"],
            RUN_DIR / "capture.log",
            0.5,
        )
    except Exception:
        set_managed(interface)
        raise
    state = {
        "running": True, "pid": process.pid, "interface": interface, "channel": channel,
        "filename": filename, "path": str(path), "started_at": time.time(), "max_bytes": max_mb * 1024 * 1024,
        "stop_reason": "",
    }
    save_state("capture", state)
    reply(**capture_details(state))


def capture_details(state: dict) -> dict:
    if not state:
        return {"running": False, "elapsed_seconds": 0, "packet_count": 0, "eapol_frames": 0, "size": 0, "filename": ""}
    running = process_alive(state.get("pid"), "dumpcap")
    path = Path(str(state.get("path", "")))
    size = path.stat().st_size if path.is_file() else 0
    if not running and state.get("running"):
        state["running"] = False
        state["stopped_at"] = time.time()
        if size >= int(state.get("max_bytes", 0)) * 0.99:
            state["stop_reason"] = "size limit reached"
        else:
            state["stop_reason"] = state.get("stop_reason") or "capture process exited"
        interface = str(state.get("interface", ""))
        if IFACE_RE.fullmatch(interface):
            set_managed(interface)
            state["interface_restored"] = True
        save_state("capture", state)
    state["running"] = running
    end = time.time() if running else float(state.get("stopped_at", state.get("started_at", time.time())))
    state["elapsed_seconds"] = max(0, int(end - float(state.get("started_at", end))))
    state["size"] = size
    state["packet_count"] = packet_count(path)
    state["eapol_frames"] = eapol_count(path)
    state.pop("path", None)
    return state


def packet_count(path: Path) -> int:
    if not path.is_file() or path.stat().st_size == 0:
        return 0
    result = run([executable("capinfos"), "-c", str(path)], timeout=20, check=False)
    match = re.search(r"Number of packets:\s*([\d,]+)", result.stdout)
    return int(match.group(1).replace(",", "")) if match else 0


def eapol_count(path: Path) -> int:
    if not path.is_file() or path.stat().st_size == 0:
        return 0
    result = run(
        [executable("tshark"), "-n", "-r", str(path), "-Y", "eapol", "-T", "fields", "-e", "frame.number"],
        timeout=20, check=False,
    )
    return sum(1 for line in result.stdout.splitlines() if line.strip())


def capture_stop() -> None:
    state = load_state("capture")
    terminate(state.get("pid"), "dumpcap")
    if state:
        interface = str(state.get("interface", ""))
        if IFACE_RE.fullmatch(interface):
            set_managed(interface)
        state.update(running=False, stopped_at=time.time(), stop_reason="stopped by user")
        save_state("capture", state)
    reply(**capture_details(state))


def capture_status() -> None:
    reply(**capture_details(load_state("capture")))


def capture_delete(filename: str) -> None:
    if not CAPTURE_RE.fullmatch(filename):
        raise HelperError("Invalid capture filename")
    state = load_state("capture")
    if state.get("running") and state.get("filename") == filename and process_alive(state.get("pid"), "dumpcap"):
        raise HelperError("Cannot delete the active capture")
    root = validate_storage(CFG["captures"])
    path = (root / filename).resolve()
    if path.parent != root or not path.is_file():
        raise HelperError("Capture not found")
    path.unlink()
    reply(deleted=filename)


def ensure_wireless_operation_idle() -> None:
    checks = (("scan", "airodump-ng"), ("capture", "dumpcap"), ("active", "aireplay-ng"))
    for state_name, expected in checks:
        state = load_state(state_name)
        executable_name = str(state.get("executable", expected))
        if state.get("running") and process_alive(state.get("pid"), executable_name):
            raise HelperError(f"Audit adapter is busy with {state_name}")


def monitor_enable(interface: str, channel_text: str) -> None:
    interface = validate_interface(interface)
    channel: int | None = None
    if channel_text:
        try:
            channel = int(channel_text)
        except ValueError as exc:
            raise HelperError("Invalid monitor channel") from exc
        if not 1 <= channel <= 196:
            raise HelperError("Monitor channel must be between 1 and 196")
    ensure_wireless_operation_idle()
    state = load_state("monitor")
    if state.get("running") and state.get("interface") == interface and state.get("channel") == channel:
        reply(**state, already_running=True)
        return
    if state.get("running"):
        raise HelperError("Another adapter is already in PinePi-managed monitor mode")
    try:
        set_monitor(interface, channel)
    except Exception:
        set_managed(interface)
        raise
    state = {"running": True, "interface": interface, "channel": channel, "started_at": time.time()}
    save_state("monitor", state)
    reply(**state)


def monitor_disable() -> None:
    state = load_state("monitor")
    interface = str(state.get("interface", ""))
    if IFACE_RE.fullmatch(interface):
        set_managed(interface)
    state.update(running=False, stopped_at=time.time())
    save_state("monitor", state)
    reply(**state)


def monitor_status() -> None:
    state = load_state("monitor")
    reply(**({"running": False} if not state else state))


def monitor_conflicts() -> None:
    result = run([executable("airmon-ng"), "check"], timeout=8, check=False)
    lines = sanitize_log_lines((result.stdout or "") + "\n" + (result.stderr or ""))[-40:]
    reply(
        available=True,
        lines=lines,
        conflicts_detected=any(line.strip() and not line.lower().startswith(("found", "pid")) for line in lines),
        action_taken=False,
        note="PinePi reports potential conflicts but never runs airmon-ng check kill automatically.",
    )


def _active_process(argv: list[str], log_path: Path) -> subprocess.Popen:
    log_path.write_bytes(b"")
    os.chmod(log_path, 0o600)
    with log_path.open("ab", buffering=0) as log:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    time.sleep(0.15)
    if process.poll() not in (None, 0):
        raise HelperError(f"Active test failed to start: {recent_log(log_path) or f'exit status {process.returncode}'}")
    return process


def active_start(
    kind: str,
    interface: str,
    channel_text: str,
    bssid: str,
    client_text: str,
    bursts_text: str,
    runtime_text: str,
) -> None:
    if kind not in {"deauth", "mdk4_deauth"}:
        raise HelperError("Unsupported active test type")
    interface = validate_interface(interface)
    if not MAC_RE.fullmatch(bssid):
        raise HelperError("Invalid target BSSID")
    client = "" if client_text == "-" else client_text
    if client and not MAC_RE.fullmatch(client):
        raise HelperError("Invalid target client")
    try:
        channel, bursts, runtime_seconds = int(channel_text), int(bursts_text), int(runtime_text)
    except ValueError as exc:
        raise HelperError("Channel, burst count, and runtime must be integers") from exc
    if not 1 <= channel <= 196:
        raise HelperError("Channel must be between 1 and 196")
    if not 1 <= bursts <= CFG["max_deauth_bursts"]:
        raise HelperError("Deauthentication burst count exceeds the configured limit")
    if not 1 <= runtime_seconds <= CFG["max_active_seconds"]:
        raise HelperError("Active-test runtime exceeds the configured limit")
    ensure_wireless_operation_idle()
    monitor = load_state("monitor")
    if monitor.get("running"):
        raise HelperError("Disable manual monitor mode before starting an active test")
    try:
        set_monitor(interface, channel)
        if kind == "deauth":
            command = [
                executable("timeout"), "--signal=TERM", "--kill-after=2s", f"{runtime_seconds}s",
                executable("aireplay-ng"), "--deauth", str(bursts), "-a", bssid.upper(),
            ]
            if client:
                command.extend(("-c", client.upper()))
            command.append(interface)
            executable_name, operation_type = "aireplay-ng", "DEAUTH_TEST"
        else:
            if client:
                raise HelperError("MDK4 target mode does not accept a client address")
            command = [
                executable("timeout"), "--signal=TERM", "--kill-after=2s", f"{runtime_seconds}s",
                executable("mdk4"), interface, "d", "-B", bssid.upper(),
            ]
            executable_name, operation_type = "mdk4", "MDK4_TEST"
        process = _active_process(command, RUN_DIR / "active.log")
    except Exception:
        set_managed(interface)
        raise
    running = process.poll() is None
    state = {
        "running": running,
        "pid": process.pid,
        "executable": executable_name,
        "type": operation_type,
        "interface": interface,
        "channel": channel,
        "bssid": bssid.upper(),
        "client": client.upper(),
        "bursts": bursts,
        "runtime_seconds": runtime_seconds,
        "started_at": time.time(),
        "deadline": time.time() + runtime_seconds,
        "exit_code": process.poll(),
    }
    if not running:
        state["stopped_at"] = time.time()
        set_managed(interface)
        state["interface_restored"] = True
    save_state("active", state)
    reply(**state)


def active_details(state: dict) -> dict:
    if not state:
        return {"running": False, "type": "", "elapsed_seconds": 0}
    expected = str(state.get("executable", "aireplay-ng"))
    running = process_alive(state.get("pid"), expected)
    if running and time.time() >= float(state.get("deadline", 0)):
        terminate(state.get("pid"), expected)
        running = False
        state["stop_reason"] = "runtime limit reached"
    if state.get("running") and not running:
        interface = str(state.get("interface", ""))
        if IFACE_RE.fullmatch(interface) and not state.get("interface_restored"):
            set_managed(interface)
            state["interface_restored"] = True
        state.update(running=False, stopped_at=time.time())
        state["stop_reason"] = state.get("stop_reason") or "active-test process exited"
        save_state("active", state)
    state["running"] = running
    end = time.time() if running else float(state.get("stopped_at", time.time()))
    state["elapsed_seconds"] = max(0, int(end - float(state.get("started_at", end))))
    state["recent_output"] = recent_log(RUN_DIR / "active.log")
    return state


def active_status() -> None:
    reply(**active_details(load_state("active")))


def active_stop() -> None:
    state = load_state("active")
    terminate(state.get("pid"), str(state.get("executable", "aireplay-ng")))
    interface = str(state.get("interface", ""))
    if IFACE_RE.fullmatch(interface) and not state.get("interface_restored"):
        set_managed(interface)
        state["interface_restored"] = True
    state.update(running=False, stopped_at=time.time(), stop_reason="stopped by user")
    save_state("active", state)
    reply(**active_details(state))


def injection_test(interface: str, channel_text: str, bssid: str) -> None:
    interface = validate_interface(interface)
    if not MAC_RE.fullmatch(bssid):
        raise HelperError("Invalid target BSSID")
    try:
        channel = int(channel_text)
    except ValueError as exc:
        raise HelperError("Invalid injection-test channel") from exc
    if not 1 <= channel <= 196:
        raise HelperError("Injection-test channel must be between 1 and 196")
    ensure_wireless_operation_idle()
    if load_state("monitor").get("running"):
        raise HelperError("Disable manual monitor mode before running an injection test")
    try:
        set_monitor(interface, channel)
        result = run(
            [executable("aireplay-ng"), "--test", "-a", bssid.upper(), interface],
            timeout=min(30, CFG["max_active_seconds"]),
            check=False,
        )
    finally:
        set_managed(interface)
    output = sanitize_log_lines((result.stdout or "") + "\n" + (result.stderr or ""))
    combined = " ".join(output).lower()
    supported = "injection is working" in combined
    reply(
        supported=supported,
        status="INJECTION_SUPPORTED" if supported else "INJECTION_UNSUPPORTED",
        explanation="Injection supported" if supported else "No confirmed injection response; the driver or target may not support this diagnostic reliably",
        output=output[-12:],
        exit_code=result.returncode,
    )


def validate_ap_network(label: str, address: str, gateway_text: str, start_text: str, end_text: str, country: str) -> None:
    network = ipaddress.ip_interface(address).network
    gateway = ipaddress.ip_address(gateway_text)
    start, end = ipaddress.ip_address(start_text), ipaddress.ip_address(end_text)
    if gateway not in network or start not in network or end not in network or start > end:
        raise HelperError(f"Invalid {label} network configuration")
    if not re.fullmatch(r"[A-Z]{2}", country):
        raise HelperError(f"Invalid {label} country code")


def select_default_uplink(route_output: str, excluded: set[str]) -> str:
    for line in route_output.splitlines():
        match = re.search(r"\bdev\s+(\S+)", line)
        if match and IFACE_RE.fullmatch(match.group(1)) and match.group(1) not in excluded:
            return match.group(1)
    return ""


def default_uplink(excluded: set[str]) -> str:
    result = run([executable("ip"), "-4", "route", "show", "default"])
    return select_default_uplink(result.stdout, excluded)


def safe_text(value: str, field: str, minimum: int, maximum: int) -> str:
    if not minimum <= len(value.encode()) <= maximum or any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise HelperError(f"Invalid {field}")
    return value


def runtime_directory(kind: str) -> Path:
    directory = RUN_DIR / kind
    directory.mkdir(parents=True, exist_ok=True, mode=0o755)
    return directory


def write_ap_configs(
    kind: str,
    interface: str,
    ssid: str,
    password: str,
    channel: int,
    country: str,
    address: str,
    gateway: str,
    dhcp_start: str,
    dhcp_end: str,
) -> tuple[Path, Path]:
    directory = runtime_directory(kind)
    with suppress_oserror():
        (directory / "dnsmasq.pid").unlink()
    hostapd_conf = directory / "hostapd.conf"
    dnsmasq_conf = directory / "dnsmasq.conf"
    network = ipaddress.ip_interface(address).network
    hostapd_conf.write_text(
        f"interface={interface}\ndriver=nl80211\nssid={ssid}\nhw_mode=g\nchannel={channel}\n"
        f"country_code={country}\nieee80211d=1\nwmm_enabled=1\nauth_algs=1\n"
        f"wpa=2\nwpa_passphrase={password}\nwpa_key_mgmt=WPA-PSK\nrsn_pairwise=CCMP\n"
    )
    dnsmasq_conf.write_text(
        f"interface={interface}\nbind-interfaces\nlisten-address={gateway}\n"
        f"pid-file={directory / 'dnsmasq.pid'}\ndhcp-leasefile={directory / 'dnsmasq.leases'}\n"
        f"dhcp-range={dhcp_start},{dhcp_end},{network.netmask},12h\n"
        f"dhcp-option=3,{gateway}\ndhcp-option=6,{gateway}\n"
        "dhcp-authoritative\ndomain-needed\nbogus-priv\n"
    )
    os.chmod(hostapd_conf, 0o600)
    os.chmod(dnsmasq_conf, 0o600)
    return hostapd_conf, dnsmasq_conf


def recent_log(path: Path) -> str:
    try:
        text = path.read_text(errors="replace")[-4096:]
    except OSError:
        return ""
    return " | ".join(sanitize_log_lines(text)[-6:])


def start_daemon(label: str, argv: list[str], log_path: Path, delay: float) -> subprocess.Popen:
    log_path.write_bytes(b"")
    os.chmod(log_path, 0o600)
    with log_path.open("ab", buffering=0) as log:
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    time.sleep(delay)
    if process.poll() is not None:
        reason = recent_log(log_path) or f"process exited with status {process.returncode}"
        raise HelperError(f"{label} failed to start: {reason}")
    return process


def configure_ap_interface(interface: str, address: str) -> None:
    nmcli = shutil.which("nmcli")
    if nmcli:
        run([nmcli, "device", "disconnect", interface], check=False)
        run([nmcli, "device", "set", interface, "managed", "no"], check=False)
    run([executable("iw"), "dev", interface, "disconnect"], check=False)
    run([executable("ip"), "link", "set", "dev", interface, "down"])
    run([executable("ip"), "addr", "flush", "dev", interface])
    run([executable("ip"), "addr", "add", address, "dev", interface])
    run([executable("ip"), "link", "set", "dev", interface, "up"])


def remove_runtime_configs(kind: str) -> None:
    for name in ("hostapd.conf", "dnsmasq.conf", "dnsmasq.pid"):
        with suppress_oserror():
            (RUN_DIR / kind / name).unlink()


def _usb_id(device: Path) -> str:
    try:
        resolved = device.resolve()
    except OSError:
        return ""
    for parent in (resolved, *resolved.parents):
        try:
            vendor = (parent / "idVendor").read_text().strip().lower()
            product = (parent / "idProduct").read_text().strip().lower()
        except OSError:
            continue
        if re.fullmatch(r"[0-9a-f]{4}", vendor) and re.fullmatch(r"[0-9a-f]{4}", product):
            return f"{vendor}:{product}"
    return ""


def _interface_driver(device: Path) -> str:
    try:
        return (device.resolve() / "driver").resolve().name.lower()
    except OSError:
        return "unknown"


def detect_management_interface() -> str:
    candidates: list[tuple[str, str, bool]] = []
    for path in sorted(Path("/sys/class/net").glob("*")):
        if not (path / "wireless").exists():
            continue
        device = path / "device"
        usb_id = _usb_id(device)
        driver = _interface_driver(device)
        try:
            device_path = str(device.resolve()).lower()
        except OSError:
            device_path = ""
        internal = not usb_id and (
            driver in CFG["management_drivers"]
            or any(marker in device_path for marker in ("/platform/", "/mmc", "/soc/"))
        )
        candidates.append((path.name, driver, internal))
    selected = next((name for name, _, internal in candidates if internal), None)
    if not selected:
        selected = next(
            (name for name, _, _ in candidates if name in CFG["management_interfaces"] and not _usb_id(Path("/sys/class/net") / name / "device")),
            None,
        )
    if not selected:
        raise HelperError("No internal non-USB Wi-Fi adapter is available for the management role")
    return validate_interface(selected)


def parse_exclusions(value: str) -> set[str]:
    result: set[str] = set()
    if not value:
        return result
    for interface in value.split(","):
        if not IFACE_RE.fullmatch(interface):
            raise HelperError("Invalid excluded uplink interface")
        result.add(interface)
    return result


def ap_start(interface: str, channel_text: str, excluded_text: str) -> None:
    interface = validate_interface(interface)
    try:
        payload = json.loads(sys.stdin.read(4096))
        if not isinstance(payload, dict):
            raise ValueError
        ssid, password = payload["ssid"], payload["password"]
        if not isinstance(ssid, str) or not isinstance(password, str):
            raise ValueError
    except (json.JSONDecodeError, KeyError, ValueError) as exc:
        raise HelperError("AP settings must be supplied as a valid JSON object") from exc
    ssid = safe_text(ssid, "SSID", 1, 32)
    password = safe_text(password, "WPA2 password", 8, 63)
    try:
        channel = int(channel_text)
    except ValueError as exc:
        raise HelperError("Invalid AP channel") from exc
    if not 1 <= channel <= 13:
        raise HelperError("AP channel must be between 1 and 13")
    validate_ap_network("Training AP", CFG["address"], CFG["gateway"], CFG["dhcp_start"], CFG["dhcp_end"], CFG["country"])
    state = load_state("training")
    hostapd_alive = process_alive(state.get("hostapd_pid"), "hostapd")
    dnsmasq_alive = process_alive(state.get("dnsmasq_pid"), "dnsmasq")
    if state.get("running") and hostapd_alive and dnsmasq_alive:
        raise HelperError("Training AP is already running")
    if hostapd_alive or dnsmasq_alive:
        terminate(state.get("dnsmasq_pid"), "dnsmasq")
        terminate(state.get("hostapd_pid"), "hostapd")
    exclusions = parse_exclusions(excluded_text) | {interface}
    management = load_state("management")
    if management.get("interface"):
        exclusions.add(str(management["interface"]))
    uplink = default_uplink(exclusions)
    hostapd_conf, dnsmasq_conf = write_ap_configs(
        "training", interface, ssid, password, channel, CFG["country"], CFG["address"],
        CFG["gateway"], CFG["dhcp_start"], CFG["dhcp_end"],
    )
    previous_forward = Path("/proc/sys/net/ipv4/ip_forward").read_text().strip()
    hostapd: subprocess.Popen | None = None
    dnsmasq: subprocess.Popen | None = None
    try:
        configure_ap_interface(interface, CFG["address"])
        nft_cleanup()
        if uplink:
            run([executable("sysctl"), "-w", "net.ipv4.ip_forward=1"])
            rules = (
                "table ip pinepi {\n"
                " chain forward { type filter hook forward priority filter; policy accept; "
                f'iifname "{interface}" oifname "{uplink}" accept; '
                f'iifname "{uplink}" oifname "{interface}" ct state established,related accept; '
                f'iifname "{interface}" drop; }}\n'
                " chain postrouting { type nat hook postrouting priority srcnat; policy accept; "
                f'oifname "{uplink}" ip saddr {ipaddress.ip_interface(CFG["address"]).network} masquerade; }}\n'
                "}\n"
            )
            run([executable("nft"), "-f", "-"], input_text=rules)
        hostapd = start_daemon("hostapd", [executable("hostapd"), str(hostapd_conf)], RUN_DIR / "training" / "hostapd.log", 0.8)
        dnsmasq_test = run([executable("dnsmasq"), "--test", "--conf-file=" + str(dnsmasq_conf)], check=False)
        if dnsmasq_test.returncode:
            raise HelperError(f"dnsmasq configuration is invalid: {(dnsmasq_test.stderr or dnsmasq_test.stdout).strip()}")
        dnsmasq = start_daemon(
            "dnsmasq", [executable("dnsmasq"), "--keep-in-foreground", "--conf-file=" + str(dnsmasq_conf)],
            RUN_DIR / "training" / "dnsmasq.log", 0.6,
        )
    except Exception as exc:
        if dnsmasq is not None:
            terminate(dnsmasq.pid, "dnsmasq")
        if hostapd is not None:
            terminate(hostapd.pid, "hostapd")
        nft_cleanup()
        run([executable("ip"), "addr", "flush", "dev", interface], check=False)
        set_managed(interface)
        if previous_forward in ("0", "1"):
            run([executable("sysctl"), "-w", f"net.ipv4.ip_forward={previous_forward}"], check=False)
        remove_runtime_configs("training")
        save_state("training", {
            "running": False, "interface": interface, "ssid": ssid, "channel": channel,
            "gateway": CFG["gateway"], "uplink": uplink, "forwarding": False,
            "last_error": str(exc), "stopped_at": time.time(),
        })
        raise
    state = {
        "running": True, "interface": interface, "ssid": ssid, "channel": channel, "uplink": uplink,
        "gateway": CFG["gateway"], "forwarding": bool(uplink), "hostapd_pid": hostapd.pid,
        "dnsmasq_pid": dnsmasq.pid, "started_at": time.time(), "previous_forward": previous_forward,
        "uplink_status": "Enabled" if uplink else "Disabled: no eligible default uplink",
    }
    save_state("training", state)
    reply(**public_ap_state(state, "training"))


def nft_cleanup() -> None:
    nft = shutil.which("nft")
    if nft:
        run([nft, "delete", "table", "ip", "pinepi"], check=False)


def cleanup_ap_runtime(state: dict, kind: str) -> None:
    """Idempotently undo only resources owned by one PinePi AP."""
    terminate(state.get("dnsmasq_pid"), "dnsmasq")
    terminate(state.get("hostapd_pid"), "hostapd")
    if kind == "training":
        nft_cleanup()
    interface = str(state.get("interface", ""))
    if IFACE_RE.fullmatch(interface) and (Path("/sys/class/net") / interface).exists():
        run([executable("ip"), "addr", "flush", "dev", interface], check=False)
        set_managed(interface)
    if kind == "training" and state.get("previous_forward") in ("0", "1"):
        run([executable("sysctl"), "-w", f"net.ipv4.ip_forward={state['previous_forward']}"], check=False)
    remove_runtime_configs(kind)


def ap_stop() -> None:
    state = load_state("training")
    cleanup_ap_runtime(state, "training")
    state.update(running=False, forwarding=False, stopped_at=time.time())
    save_state("training", state)
    reply(**public_ap_state(state, "training"))


def clients(interface: str) -> list[dict]:
    if not interface:
        return []
    result = run([executable("iw"), "dev", interface, "station", "dump"], timeout=5, check=False)
    items: list[dict] = []
    current: dict | None = None
    for line in result.stdout.splitlines():
        match = re.match(r"Station\s+(\S+)", line)
        if match and MAC_RE.fullmatch(match.group(1)):
            current = {"mac": match.group(1).upper(), "signal": None, "rx_bytes": 0, "tx_bytes": 0}
            items.append(current)
        elif current:
            key_value = line.strip().split(":", 1)
            if len(key_value) != 2:
                continue
            key, value = key_value[0], key_value[1].strip()
            number = re.match(r"-?\d+", value)
            if key == "signal" and number:
                current["signal"] = int(number.group())
            elif key in ("rx bytes", "tx bytes") and number:
                current[key.replace(" ", "_")] = int(number.group())
    return items


def public_ap_state(state: dict, kind: str) -> dict:
    running = process_alive(state.get("hostapd_pid"), "hostapd") and process_alive(state.get("dnsmasq_pid"), "dnsmasq")
    if state.get("running") and not running:
        cleanup_ap_runtime(state, kind)
        state.update(running=False, forwarding=False, stopped_at=time.time())
        log_error = recent_log(RUN_DIR / kind / "dnsmasq.log") or recent_log(RUN_DIR / kind / "hostapd.log")
        if log_error:
            state["last_error"] = log_error
        save_state(kind, state)
    private_keys = {
        "previous_forward", "hostapd_pid", "dnsmasq_pid", "password", "passphrase", "wpa_passphrase",
    }
    result = {key: value for key, value in state.items() if key not in private_keys}
    result["running"] = running
    result["forwarding"] = bool(running and state.get("forwarding"))
    result["clients"] = clients(str(state.get("interface", ""))) if running else []
    result["client_count"] = len(result["clients"])
    return result


def ap_status() -> None:
    state = load_state("training")
    if not state:
        state = {"running": False, "forwarding": False, "gateway": CFG["gateway"], "clients": [], "client_count": 0}
    reply(**public_ap_state(state, "training"))


def ap_credentials() -> None:
    state = load_state("training")
    if not (
        state.get("running")
        and process_alive(state.get("hostapd_pid"), "hostapd")
        and process_alive(state.get("dnsmasq_pid"), "dnsmasq")
    ):
        raise HelperError("Training AP is not running")
    try:
        lines = (RUN_DIR / "training" / "hostapd.conf").read_text().splitlines()
    except OSError as exc:
        raise HelperError("Training AP credential is unavailable") from exc
    password = next((line.split("=", 1)[1] for line in lines if line.startswith("wpa_passphrase=")), "")
    if not password:
        raise HelperError("Training AP credential is unavailable")
    reply(ssid=state.get("ssid", ""), password=password, channel=state.get("channel"))


LOG_FILES = {
    "management_hostapd": RUN_DIR / "management" / "hostapd.log",
    "management_dnsmasq": RUN_DIR / "management" / "dnsmasq.log",
    "training_hostapd": RUN_DIR / "training" / "hostapd.log",
    "training_dnsmasq": RUN_DIR / "training" / "dnsmasq.log",
    "recon": RUN_DIR / "recon.log",
    "capture": RUN_DIR / "capture.log",
    "active": RUN_DIR / "active.log",
}


def sanitize_log_lines(text: str) -> list[str]:
    result: list[str] = []
    for raw in text[-16384:].splitlines()[-80:]:
        line = "".join(char if ord(char) >= 32 and ord(char) != 127 else "�" for char in raw)
        line = re.sub(
            r"(?i)(\b(?:password|passphrase|wpa_passphrase|psk)\b[\"']?\s*[=:]\s*)[\"']?[^,\s}\"]+[\"']?",
            r"\1[redacted]",
            line,
        )
        result.append(line[:500])
    return result


def logs(source: str) -> None:
    if source == "application":
        result = run(
            [executable("journalctl"), "-u", "pinepi.service", "-n", "80", "--no-pager", "-o", "short-iso"],
            timeout=8,
            check=False,
        )
        text = result.stdout or result.stderr
    elif source == "management_service":
        result = run(
            [executable("journalctl"), "-u", "pinepi-management-ap.service", "-n", "80", "--no-pager", "-o", "short-iso"],
            timeout=8,
            check=False,
        )
        text = result.stdout or result.stderr
    elif source in LOG_FILES:
        path = LOG_FILES[source]
        try:
            text = path.read_text(errors="replace") if path.is_file() and not path.is_symlink() else ""
        except OSError:
            text = ""
    else:
        raise HelperError("Unsupported log source")
    reply(source=source, lines=sanitize_log_lines(text), truncated=len(text) > 16384)


def management_start() -> None:
    if not CFG["management_enabled"]:
        state = {"enabled": False, "running": False, "forwarding": False, "gateway": CFG["management_gateway"]}
        save_state("management", state)
        reply(**state)
        return
    interface = detect_management_interface()
    ssid = safe_text(CFG["management_ssid"], "management SSID", 1, 32)
    password = safe_text(CFG["management_password"], "management WPA2 password", 8, 63)
    channel = CFG["management_channel"]
    if not 1 <= channel <= 13:
        raise HelperError("Management AP channel must be between 1 and 13")
    validate_ap_network(
        "Management AP", CFG["management_address"], CFG["management_gateway"],
        CFG["management_dhcp_start"], CFG["management_dhcp_end"], CFG["management_country"],
    )
    if ipaddress.ip_interface(CFG["management_address"]).network.overlaps(ipaddress.ip_interface(CFG["address"]).network):
        raise HelperError("Management AP and Training AP subnets must not overlap")
    current = load_state("management")
    hostapd_alive = process_alive(current.get("hostapd_pid"), "hostapd")
    dnsmasq_alive = process_alive(current.get("dnsmasq_pid"), "dnsmasq")
    if current.get("running") and hostapd_alive and dnsmasq_alive:
        reply(**public_ap_state(current, "management"))
        return
    if hostapd_alive or dnsmasq_alive:
        terminate(current.get("dnsmasq_pid"), "dnsmasq")
        terminate(current.get("hostapd_pid"), "hostapd")
    training = load_state("training")
    if training.get("running") and training.get("interface") == interface:
        raise HelperError("The internal management adapter is already used by the Training AP")
    hostapd_conf, dnsmasq_conf = write_ap_configs(
        "management", interface, ssid, password, channel, CFG["management_country"], CFG["management_address"],
        CFG["management_gateway"], CFG["management_dhcp_start"], CFG["management_dhcp_end"],
    )
    hostapd: subprocess.Popen | None = None
    dnsmasq: subprocess.Popen | None = None
    try:
        configure_ap_interface(interface, CFG["management_address"])
        hostapd = start_daemon("management hostapd", [executable("hostapd"), str(hostapd_conf)], RUN_DIR / "management" / "hostapd.log", 0.8)
        dnsmasq_test = run([executable("dnsmasq"), "--test", "--conf-file=" + str(dnsmasq_conf)], check=False)
        if dnsmasq_test.returncode:
            raise HelperError(f"management dnsmasq configuration is invalid: {(dnsmasq_test.stderr or dnsmasq_test.stdout).strip()}")
        dnsmasq = start_daemon(
            "management dnsmasq", [executable("dnsmasq"), "--keep-in-foreground", "--conf-file=" + str(dnsmasq_conf)],
            RUN_DIR / "management" / "dnsmasq.log", 0.6,
        )
    except Exception as exc:
        if dnsmasq is not None:
            terminate(dnsmasq.pid, "dnsmasq")
        if hostapd is not None:
            terminate(hostapd.pid, "hostapd")
        run([executable("ip"), "addr", "flush", "dev", interface], check=False)
        set_managed(interface)
        remove_runtime_configs("management")
        save_state("management", {
            "enabled": True, "running": False, "interface": interface, "ssid": ssid, "channel": channel,
            "gateway": CFG["management_gateway"], "forwarding": False, "last_error": str(exc),
        })
        raise
    state = {
        "enabled": True, "running": True, "interface": interface, "ssid": ssid, "channel": channel,
        "gateway": CFG["management_gateway"], "forwarding": False, "hostapd_pid": hostapd.pid,
        "dnsmasq_pid": dnsmasq.pid, "started_at": time.time(), "web_url": f"http://{CFG['management_gateway']}:8000",
    }
    save_state("management", state)
    reply(**public_ap_state(state, "management"))


def management_stop() -> None:
    state = load_state("management")
    cleanup_ap_runtime(state, "management")
    state.update(running=False, forwarding=False, stopped_at=time.time())
    save_state("management", state)
    reply(**public_ap_state(state, "management"))


def management_status() -> None:
    state = load_state("management")
    if not state:
        state = {
            "enabled": CFG["management_enabled"], "running": False, "forwarding": False,
            "gateway": CFG["management_gateway"], "web_url": f"http://{CFG['management_gateway']}:8000",
            "last_error": "Management AP has not started",
        }
    reply(**public_ap_state(state, "management"))


def management_start_safe() -> None:
    try:
        management_start()
    except HelperError as exc:
        state = load_state("management")
        state.update(
            enabled=CFG["management_enabled"],
            running=False,
            forwarding=False,
            gateway=CFG["management_gateway"],
            web_url=f"http://{CFG['management_gateway']}:8000",
            last_error=str(exc),
        )
        save_state("management", state)
        raise


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(description="PinePi restricted privileged helper")
    commands = value.add_subparsers(dest="action", required=True)
    scan = commands.add_parser("scan-start"); scan.add_argument("interface")
    commands.add_parser("scan-stop"); commands.add_parser("scan-status")
    capture = commands.add_parser("capture-start"); capture.add_argument("interface"); capture.add_argument("channel"); capture.add_argument("max_mb")
    commands.add_parser("capture-stop"); commands.add_parser("capture-status")
    delete = commands.add_parser("capture-delete"); delete.add_argument("filename")
    ap = commands.add_parser("ap-start"); ap.add_argument("interface"); ap.add_argument("channel"); ap.add_argument("excluded_interfaces", nargs="?", default="")
    commands.add_parser("ap-stop"); commands.add_parser("ap-status")
    commands.add_parser("ap-credentials")
    commands.add_parser("management-start"); commands.add_parser("management-stop"); commands.add_parser("management-status")
    log = commands.add_parser("logs"); log.add_argument("source")
    monitor = commands.add_parser("monitor-enable"); monitor.add_argument("interface"); monitor.add_argument("channel", nargs="?", default="")
    commands.add_parser("monitor-disable"); commands.add_parser("monitor-status")
    commands.add_parser("monitor-conflicts")
    active = commands.add_parser("active-start")
    active.add_argument("type"); active.add_argument("interface"); active.add_argument("channel")
    active.add_argument("bssid"); active.add_argument("client"); active.add_argument("bursts"); active.add_argument("runtime")
    commands.add_parser("active-stop"); commands.add_parser("active-status")
    injection = commands.add_parser("injection-test")
    injection.add_argument("interface"); injection.add_argument("channel"); injection.add_argument("bssid")
    return value


def main() -> int:
    if os.geteuid() != 0:
        raise HelperError("pinepi-helper must run as root (normally through restricted sudo)")
    args = parser().parse_args()
    actions = {
        "scan-start": lambda: scan_start(args.interface), "scan-stop": scan_stop, "scan-status": scan_status,
        "capture-start": lambda: capture_start(args.interface, args.channel, args.max_mb),
        "capture-stop": capture_stop, "capture-status": capture_status,
        "capture-delete": lambda: capture_delete(args.filename),
        "ap-start": lambda: ap_start(args.interface, args.channel, args.excluded_interfaces),
        "ap-stop": ap_stop, "ap-status": ap_status, "ap-credentials": ap_credentials,
        "management-start": management_start_safe, "management-stop": management_stop,
        "management-status": management_status,
        "logs": lambda: logs(args.source),
        "monitor-enable": lambda: monitor_enable(args.interface, args.channel),
        "monitor-disable": monitor_disable, "monitor-status": monitor_status,
        "monitor-conflicts": monitor_conflicts,
        "active-start": lambda: active_start(args.type, args.interface, args.channel, args.bssid, args.client, args.bursts, args.runtime),
        "active-stop": active_stop, "active-status": active_status,
        "injection-test": lambda: injection_test(args.interface, args.channel, args.bssid),
    }
    actions[args.action]()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except HelperError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")), file=sys.stderr)
        raise SystemExit(1)
